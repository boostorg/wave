project
    : requirements
        <library>/boost/program_options//boost_program_options/<link>static
        <library>/boost/filesystem//boost_filesystem
        <library>/boost/wave//boost_wave
        <library>/boost/system//boost_system
        <library>/boost/thread//boost_thread
    ;

exe hannibal
    :   ../hannibal.cpp
    ;  

